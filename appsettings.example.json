{
  "Servers": [
    {
      "Id": "interne",
      "BaseUrl": "https://gitlab.exemple.com",
      "GroupToken": "REMPLACEZ_PAR_UN_GROUP_ACCESS_TOKEN_read_api",
      "ProjectIds": ["namespace/projet-ou-id-numerique"],
      "AllowSelfSignedCertificates": false,
      "RequestTimeoutSeconds": 60
    }
  ],
  "Export": {
    "OutputDirectory": "output",
    "TrackedLabels": [
      "Prod::QA Backlog",
      "Prod::Code pre-review",
      "Prod::Code review",
      "Prod::To Fix",
      "Prod::QA InProgress",
      "Prod:: PO Validation"
    ],
    "TrackedTransitions": [
      { "From": "Prod::Code pre-review", "To": "Prod::Code review" },
      { "From": "Prod::Code review", "To": "Prod::QA Backlog" },
      { "From": "Prod::QA Backlog", "To": "Prod::To Fix" },
      { "From": "Prod::QA InProgress", "To": "Prod:: PO Validation" }
    ],
    "Teams": {
      "Backend": ["alice", "bob"],
      "Frontend": ["carol", "dave"]
    },
    "LabelPhases": {
      "Prod::Code pre-review": "dev",
      "Prod::Code review": "review",
      "Prod::QA Backlog": "qawait",
      "Prod::QA InProgress": "qa",
      "Prod::To Fix": "tofix",
      "Prod:: PO Validation": "po"
    },
    "Periods": [
      { "Key": "dev",    "Name": "Development",   "Color": "#2188ff", "Role": "active" },
      { "Key": "review", "Name": "Code review",   "Color": "#8957e5", "Role": "active" },
      { "Key": "qawait", "Name": "QA wait",       "Color": "#b8800a", "Role": "wait"   },
      { "Key": "qa",     "Name": "QA",            "Color": "#c79a06", "Role": "active" },
      { "Key": "tofix",  "Name": "To fix",        "Color": "#ec4899", "Role": "active" },
      { "Key": "po",     "Name": "PO validation", "Color": "#0f9e8e", "Role": "wait"   },
      { "Key": "uiux",   "Name": "UI/UX",         "Color": "#2dd4bf", "Role": "nogc"   }
    ]
  },
  "Auth": {
    "Authority": "https://gitlab.exemple.com",
    "ClientId": "APPLICATION_ID_DE_VOTRE_APP_OAUTH_GITLAB",
    "ClientSecret": "SECRET_DE_VOTRE_APP_OAUTH_GITLAB",
    "CallbackPath": "/signin-gitlab",
    "AdminUsers": ["votre_username_gitlab"],
    "DefaultViewId": ""
  },
  "Dashboard": {
    "SchemaVersion": 1,
    "DefaultPageId": "",
    "Pages": [
      {
        "Id": "direction",
        "Kind": "modular",
        "Nav": { "Label": "Vue Direction", "Icon": "dashboard", "Order": 50, "ShowFilters": true },
        "Layout": { "Cols": 12, "Gap": "var(--space-4)", "RowUnit": 88 },
        "Widgets": [
          { "Id": "w1", "Type": "KpiCard", "Data": "kpi.progress", "Layout": { "W": 3 } },
          { "Id": "w2", "Type": "KpiCard", "Data": "kpi.weight", "Layout": { "W": 3 } },
          { "Id": "w3", "Type": "KpiCard", "Data": "kpi.approvals", "Layout": { "W": 3 } },
          { "Id": "w4", "Type": "KpiCard", "Data": "kpi.cycle", "Layout": { "W": 3 } },
          { "Id": "w5", "Type": "PhaseBars", "Data": "phase.effective", "Layout": { "W": 6 } },
          { "Id": "w6", "Type": "Donut", "Data": "types.distribution", "Layout": { "W": 6 } },
          { "Id": "w7", "Type": "DataTable", "Data": "pivot.byType", "Layout": { "W": 12 } }
        ]
      }
    ]
  }
}
